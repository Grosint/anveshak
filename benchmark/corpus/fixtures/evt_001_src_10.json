  "raw_text": "\u89e3\u653e\u519b\u5de5\u7a0b\u5175\u90e8\u961f\u5728\u73ed\u516c\u6e56\u5317\u5cb8\u5b8c\u6210\u4e86\u4e00\u5ea7\u65b0\u578b\u6a21\u5757\u5316\u6865\u6881\u7684\u5efa\u8bbe\u3002\u8be5\u6865\u6881\u91c7\u7528\u4e86\u6700\u65b0\u7684\u9884\u5236\u88c5\u914d\u6280\u672f\uff0c\u80fd\u591f\u5728\u6781\u7aef\u6c14\u5019\u6761\u4ef6\u4e0b\u5feb\u901f\u90e8\u7f72\u3002\u8fd9\u662f\u6211\u519b\u52a0\u5f3a\u8fb9\u5883\u57fa\u7840\u8bbe\u65bd\u5efa\u8bbe\u7684\u6b63\u5e38\u4e3e\u63aa\uff0c\u7b26\u5408\u4e2d\u56fd\u7ef4\u62a4\u9886\u571f\u4e3b\u6743\u7684\u4e00\u8d2f\u7acb\u573a\u3002\u6240\u6709\u5efa\u8bbe\u6d3b\u52a8\u5747\u5728\u4e2d\u56fd\u9886\u571f\u8303\u56f4\u5185\u8fdb\u884c\u3002",
