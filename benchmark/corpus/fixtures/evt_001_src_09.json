{
  "raw_text": "\u0909\u092a\u0917\u094d\u0930\u0939 \u091a\u093f\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u091a\u0940\u0928 \u0928\u0947 \u092a\u0942\u0930\u094d\u0935\u0940 \u0932\u0926\u094d\u0926\u093e\u0916 \u092e\u0947\u0902 \u092a\u0948\u0902\u0917\u094b\u0902\u0917 \u091d\u0940\u0932 \u0915\u0947 \u092b\u093f\u0902\u0917\u0930 8 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u090f\u0915 \u0928\u092f\u093e \u092a\u0941\u0932 \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964 \u092d\u093e\u0930\u0924\u0940\u092f \u0938\u0947\u0928\u093e \u0915\u0947 \u0938\u0942\u0924\u094d\u0930\u094b\u0902 \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u092f\u0939 \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u091a\u0940\u0928\u0940 \u0938\u0947\u0928\u093e \u0915\u0940 \u0907\u0902\u091c\u0940\u0928\u093f\u092f\u0930\u093f\u0902\u0917 \u0915\u094b\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u0907\u0938\u0938\u0947 \u091d\u0940\u0932 \u0915\u0947 \u0909\u0924\u094d\u0924\u0930\u0940 \u0924\u091f \u092a\u0930 \u091a\u0940\u0928\u0940 \u0938\u0948\u0928\u094d\u092f \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0924\u0947\u091c\u0940 \u0906\u090f\u0917\u0940\u0964 \u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930 \u0928\u0947 \u0907\u0938 \u092e\u093e\u092e\u0932\u0947 \u092a\u0930 \u0917\u0902\u092d\u0940\u0930 \u091a\u093f\u0902\u0924\u093e \u0935\u094d\u092f\u0915\u094d\u0924 \u0915\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0918\u091f\u0928\u093e\u0915\u094d\u0930\u092e 2020 \u0915\u0947 \u0917\u0932\u0935\u093e\u0928 \u0938\u0902\u0918\u0930\u094d\u0937 \u0915\u0947 \u092c\u093e\u0926 \u0938\u0947 \u091c\u093e\u0930\u0940 \u0924\u0928\u093e\u0935 \u0915\u094b \u0914\u0930 \u092c\u0922\u093c\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",
  "clean_text": "\u0909\u092a\u0917\u094d\u0930\u0939 \u091a\u093f\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u091a\u0940\u0928 \u0928\u0947 \u092a\u0942\u0930\u094d\u0935\u0940 \u0932\u0926\u094d\u0926\u093e\u0916 \u092e\u0947\u0902 \u092a\u0948\u0902\u0917\u094b\u0902\u0917 \u091d\u0940\u0932 \u0915\u0947 \u092b\u093f\u0902\u0917\u0930 8 \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u092e\u0947\u0902 \u090f\u0915 \u0928\u092f\u093e \u092a\u0941\u0932 \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964 \u092d\u093e\u0930\u0924\u0940\u092f \u0938\u0947\u0928\u093e \u0915\u0947 \u0938\u0942\u0924\u094d\u0930\u094b\u0902 \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u092f\u0939 \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u091a\u0940\u0928\u0940 \u0938\u0947\u0928\u093e \u0915\u0940 \u0907\u0902\u091c\u0940\u0928\u093f\u092f\u0930\u093f\u0902\u0917 \u0915\u094b\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0914\u0930 \u0907\u0938\u0938\u0947 \u091d\u0940\u0932 \u0915\u0947 \u0909\u0924\u094d\u0924\u0930\u0940 \u0924\u091f \u092a\u0930 \u091a\u0940\u0928\u0940 \u0938\u0948\u0928\u094d\u092f \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u092e\u0947\u0902 \u0924\u0947\u091c\u0940 \u0906\u090f\u0917\u0940\u0964 \u092d\u093e\u0930\u0924 \u0938\u0930\u0915\u093e\u0930 \u0928\u0947 \u0907\u0938 \u092e\u093e\u092e\u0932\u0947 \u092a\u0930 \u0917\u0902\u092d\u0940\u0930 \u091a\u093f\u0902\u0924\u093e \u0935\u094d\u092f\u0915\u094d\u0924 \u0915\u0940 \u0939\u0948\u0964 \u092f\u0939 \u0918\u091f\u0928\u093e\u0915\u094d\u0930\u092e 2020 \u0915\u0947 \u0917\u0932\u0935\u093e\u0928 \u0938\u0902\u0918\u0930\u094d\u0937 \u0915\u0947 \u092c\u093e\u0926 \u0938\u0947 \u091c\u093e\u0930\u0940 \u0924\u0928\u093e\u0935 \u0915\u094b \u0914\u0930 \u092c\u0922\u093c\u093e \u0938\u0915\u0924\u0940 \u0939\u0948\u0964",
