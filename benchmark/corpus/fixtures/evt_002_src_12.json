{
  "raw_text": "\u0623\u0643\u062f\u062a \u0645\u0635\u0627\u062f\u0631 \u0639\u0633\u0643\u0631\u064a\u0629 \u0623\u0646 \u0645\u0642\u0627\u062a\u0644\u064a \u062c\u0645\u0627\u0639\u0629 \u0627\u0644\u062d\u0648\u062b\u064a \u0627\u0633\u062a\u0648\u0644\u0648\u0627 \u0639\u0644\u0649 \u0633\u0641\u064a\u0646\u0629 \u0627\u0644\u0634\u062d\u0646 \u063a\u0627\u0644\u0627\u0643\u0633\u064a \u0644\u064a\u062f\u0631 \u0641\u064a \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0631\u0648\u062d\u064a\u0629 \u0639\u0633\u0643\u0631\u064a\u0629. \u0627\u0644\u0633\u0641\u064a\u0646\u0629 \u0627\u0644\u062a\u064a \u062a\u0631\u0641\u0639 \u0639\u0644\u0645 \u062c\u0632\u0631 \u0627\u0644\u0628\u0647\u0627\u0645\u0627 \u0645\u0645\u0644\u0648\u0643\u0629 \u062c\u0632\u0626\u064a\u0627\u064b \u0644\u0631\u062c\u0644 \u0623\u0639\u0645\u0627\u0644 \u0625\u0633\u0631\u0627\u0626\u064a\u0644\u064a. \u062a\u0645 \u0627\u062d\u062a\u062c\u0627\u0632 \u0637\u0627\u0642\u0645 \u0627\u0644\u0633\u0641\u064a\u0646\u0629 \u0627\u0644\u0645\u0643\u0648\u0646 \u0645\u0646 25 \u0641\u0631\u062f\u0627\u064b \u0648\u062a\u0645 \u062a\u0648\u062c\u064a\u0647 \u0627\u0644\u0633\u0641\u064a\u0646\u0629 \u0646\u062d\u0648 \u0645\u064a\u0646\u0627\u0621 \u0627\u0644\u062d\u062f\u064a\u062f\u0629 \u0627\u0644\u064a\u0645\u0646\u064a.",
  "clean_text": "\u0623\u0643\u062f\u062a \u0645\u0635\u0627\u062f\u0631 \u0639\u0633\u0643\u0631\u064a\u0629 \u0623\u0646 \u0645\u0642\u0627\u062a\u0644\u064a \u062c\u0645\u0627\u0639\u0629 \u0627\u0644\u062d\u0648\u062b\u064a \u0627\u0633\u062a\u0648\u0644\u0648\u0627 \u0639\u0644\u0649 \u0633\u0641\u064a\u0646\u0629 \u0627\u0644\u0634\u062d\u0646 \u063a\u0627\u0644\u0627\u0643\u0633\u064a \u0644\u064a\u062f\u0631 \u0641\u064a \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u0631\u0648\u062d\u064a\u0629 \u0639\u0633\u0643\u0631\u064a\u0629. \u0627\u0644\u0633\u0641\u064a\u0646\u0629 \u0627\u0644\u062a\u064a \u062a\u0631\u0641\u0639 \u0639\u0644\u0645 \u062c\u0632\u0631 \u0627\u0644\u0628\u0647\u0627\u0645\u0627 \u0645\u0645\u0644\u0648\u0643\u0629 \u062c\u0632\u0626\u064a\u0627\u064b \u0644\u0631\u062c\u0644 \u0623\u0639\u0645\u0627\u0644 \u0625\u0633\u0631\u0627\u0626\u064a\u0644\u064a. \u062a\u0645 \u0627\u062d\u062a\u062c\u0627\u0632 \u0637\u0627\u0642\u0645 \u0627\u0644\u0633\u0641\u064a\u0646\u0629 \u0627\u0644\u0645\u0643\u0648\u0646 \u0645\u0646 25 \u0641\u0631\u062f\u0627\u064b \u0648\u062a\u0645 \u062a\u0648\u062c\u064a\u0647 \u0627\u0644\u0633\u0641\u064a\u0646\u0629 \u0646\u062d\u0648 \u0645\u064a\u0646\u0627\u0621 \u0627\u0644\u062d\u062f\u064a\u062f\u0629 \u0627\u0644\u064a\u0645\u0646\u064a.",
