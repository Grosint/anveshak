{
  "raw_text": "\u0623\u0639\u0644\u0646\u062a \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0645\u0633\u0644\u062d\u0629 \u0627\u0644\u064a\u0645\u0646\u064a\u0629 \u0639\u0646 \u0627\u062d\u062a\u062c\u0627\u0632 \u0627\u0644\u0633\u0641\u064a\u0646\u0629 \u0627\u0644\u0625\u0633\u0631\u0627\u0626\u064a\u0644\u064a\u0629 \u063a\u0627\u0644\u0627\u0643\u0633\u064a \u0644\u064a\u062f\u0631 \u0641\u064a \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631. \u062c\u0627\u0621\u062a \u0647\u0630\u0647 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0631\u062f\u0627\u064b \u0639\u0644\u0649 \u0627\u0644\u0639\u062f\u0648\u0627\u0646 \u0627\u0644\u0625\u0633\u0631\u0627\u0626\u064a\u0644\u064a \u0639\u0644\u0649 \u063a\u0632\u0629 \u0648\u062a\u0636\u0627\u0645\u0646\u0627\u064b \u0645\u0639 \u0627\u0644\u0634\u0639\u0628 \u0627\u0644\u0641\u0644\u0633\u0637\u064a\u0646\u064a. \u0633\u064a\u062a\u0645 \u0627\u062d\u062a\u062c\u0627\u0632 \u0627\u0644\u0633\u0641\u064a\u0646\u0629 \u0648\u0637\u0627\u0642\u0645\u0647\u0627 \u062d\u062a\u0649 \u064a\u062a\u0648\u0642\u0641 \u0627\u0644\u0639\u062f\u0648\u0627\u0646 \u0639\u0644\u0649 \u063a\u0632\u0629. \u0646\u062d\u0630\u0631 \u062c\u0645\u064a\u0639 \u0627\u0644\u0633\u0641\u0646 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0625\u0633\u0631\u0627\u0626\u064a\u0644 \u0645\u0646 \u0627\u0644\u0639\u0628\u0648\u0631 \u0639\u0628\u0631 \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631.",
  "clean_text": "\u0623\u0639\u0644\u0646\u062a \u0627\u0644\u0642\u0648\u0627\u062a \u0627\u0644\u0645\u0633\u0644\u062d\u0629 \u0627\u0644\u064a\u0645\u0646\u064a\u0629 \u0639\u0646 \u0627\u062d\u062a\u062c\u0627\u0632 \u0627\u0644\u0633\u0641\u064a\u0646\u0629 \u0627\u0644\u0625\u0633\u0631\u0627\u0626\u064a\u0644\u064a\u0629 \u063a\u0627\u0644\u0627\u0643\u0633\u064a \u0644\u064a\u062f\u0631 \u0641\u064a \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631. \u062c\u0627\u0621\u062a \u0647\u0630\u0647 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0631\u062f\u0627\u064b \u0639\u0644\u0649 \u0627\u0644\u0639\u062f\u0648\u0627\u0646 \u0627\u0644\u0625\u0633\u0631\u0627\u0626\u064a\u0644\u064a \u0639\u0644\u0649 \u063a\u0632\u0629 \u0648\u062a\u0636\u0627\u0645\u0646\u0627\u064b \u0645\u0639 \u0627\u0644\u0634\u0639\u0628 \u0627\u0644\u0641\u0644\u0633\u0637\u064a\u0646\u064a. \u0633\u064a\u062a\u0645 \u0627\u062d\u062a\u062c\u0627\u0632 \u0627\u0644\u0633\u0641\u064a\u0646\u0629 \u0648\u0637\u0627\u0642\u0645\u0647\u0627 \u062d\u062a\u0649 \u064a\u062a\u0648\u0642\u0641 \u0627\u0644\u0639\u062f\u0648\u0627\u0646 \u0639\u0644\u0649 \u063a\u0632\u0629. \u0646\u062d\u0630\u0631 \u062c\u0645\u064a\u0639 \u0627\u0644\u0633\u0641\u0646 \u0627\u0644\u0645\u0631\u062a\u0628\u0637\u0629 \u0628\u0625\u0633\u0631\u0627\u0626\u064a\u0644 \u0645\u0646 \u0627\u0644\u0639\u0628\u0648\u0631 \u0639\u0628\u0631 \u0627\u0644\u0628\u062d\u0631 \u0627\u0644\u0623\u062d\u0645\u0631.",
