{
  "annotations": {"list": []},
  "description": "M4 Vision Service — YOLO object detection, CLIP classification, deepfake scoring, analysis throughput and latency.",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [{"title": "← Overview", "url": "/d/anveshak-overview", "type": "dashboards", "icon": "external link"}],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Vision Analysis Summary",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "#A4C8E8", "value": null}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "description": "Total vision analyses completed in the last hour across all types.",
      "id": 1,
      "options": {"reduceOptions": {"calcs": ["sum"]}, "colorMode": "background", "graphMode": "area"},
      "title": "Total Analyses (1h)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "increase(vision_analyses_total[1h])", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "#A4C8E8", "value": null}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "description": "YOLO object detection analyses completed in the last hour.",
      "id": 2,
      "options": {"reduceOptions": {"calcs": ["sum"]}, "colorMode": "background", "graphMode": "area"},
      "title": "YOLO Analyses (1h)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "increase(vision_analyses_total{analysis_type=\"yolo\"}[1h])", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "#A4C8E8", "value": null}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "description": "Deepfake detection analyses (image and video) completed in the last hour.",
      "id": 3,
      "options": {"reduceOptions": {"calcs": ["sum"]}, "colorMode": "background", "graphMode": "area"},
      "title": "Deepfake Analyses (1h)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "increase(vision_analyses_total{analysis_type=~\"deepfake.*\"}[1h])", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "#A8D5BA", "value": null}, {"color": "#FFCBA4", "value": 5}, {"color": "#F4A4A4", "value": 20}]}},
      "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 1},
      "description": "Media items scoring above 0.8 deepfake probability. Investigate these for potential synthetic content.",
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["sum"]}, "colorMode": "background", "graphMode": "area"},
      "title": "High-Risk Deepfakes >0.8 (1h)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "increase(vision_deepfake_score_bucket{le=\"1.0\"}[1h]) - increase(vision_deepfake_score_bucket{le=\"0.8\"}[1h])", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "#A8D5BA", "value": null}, {"color": "#FFE0A3", "value": 15}, {"color": "#F4A4A4", "value": 60}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 1},
      "description": "95th percentile analysis latency. Check vision worker health if this exceeds 60s.",
      "id": 5,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "title": "Analysis Latency p95",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, rate(vision_analysis_duration_seconds_bucket[5m]))", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "#A8D5BA", "value": null}, {"color": "#FFE0A3", "value": 3}, {"color": "#F4A4A4", "value": 10}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 1},
      "description": "ARQ job failures in the last 5 minutes. Persistent failures indicate model loading or OOM issues.",
      "id": 6,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"},
      "title": "Vision ARQ Failures (5m)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "increase(arq_jobs_failed_total[5m])", "refId": "A"}]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "title": "Analysis Throughput",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 10}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "description": "Per-minute rate of vision analyses broken down by type (YOLO, CLIP, deepfake).",
      "id": 10,
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Vision Analyses by Type (rate/min)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (analysis_type) (rate(vision_analyses_total[5m])) * 60", "legendFormat": "{{analysis_type}}", "refId": "A"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "s", "custom": {"lineWidth": 2}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "description": "Latency distribution (p50, p95, p99) across all vision analysis types.",
      "id": 11,
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Analysis Latency Percentiles (all types)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.50, rate(vision_analysis_duration_seconds_bucket[5m]))", "legendFormat": "p50", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.95, rate(vision_analysis_duration_seconds_bucket[5m]))", "legendFormat": "p95", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "histogram_quantile(0.99, rate(vision_analysis_duration_seconds_bucket[5m]))", "legendFormat": "p99", "refId": "C"}
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "id": 102,
      "title": "Deepfake Score Distribution",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Distribution of deepfake probability scores across all analysed media items. Scores near 1.0 indicate high confidence of synthetic content.",
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 10}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "id": 20,
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Deepfake Score Buckets (rate/min) — items per probability band",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "rate(vision_deepfake_score_bucket{le=\"0.2\"}[5m]) * 60", "legendFormat": "≤0.2 (low risk)", "refId": "A"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "(rate(vision_deepfake_score_bucket{le=\"0.6\"}[5m]) - rate(vision_deepfake_score_bucket{le=\"0.4\"}[5m])) * 60", "legendFormat": "0.4–0.6 (medium)", "refId": "B"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "(rate(vision_deepfake_score_bucket{le=\"0.9\"}[5m]) - rate(vision_deepfake_score_bucket{le=\"0.8\"}[5m])) * 60", "legendFormat": "0.8–0.9 (high risk)", "refId": "C"},
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "(rate(vision_deepfake_score_bucket{le=\"1.0\"}[5m]) - rate(vision_deepfake_score_bucket{le=\"0.95\"}[5m])) * 60", "legendFormat": ">0.95 (very high risk)", "refId": "D"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "fixed", "fixedColor": "#F4A4A4"}, "unit": "short", "custom": {"lineWidth": 3, "fillOpacity": 10}},
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "description": "Cumulative count of items scoring above 0.8 deepfake probability over a rolling 1-hour window.",
      "id": 21,
      "options": {"tooltip": {"mode": "single"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "High-Confidence Deepfakes >0.8 (cumulative, 1h window)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "increase(vision_deepfake_score_bucket{le=\"1.0\"}[1h]) - increase(vision_deepfake_score_bucket{le=\"0.8\"}[1h])", "legendFormat": "Deepfakes >0.8", "refId": "A"}
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "id": 103,
      "title": "Vision Service Logs",
      "type": "row"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 24},
      "description": "Structured logs from the vision service. Filter by level or analysis_type for targeted debugging.",
      "id": 30,
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "showLabels": true, "showTime": true, "sortOrder": "Descending"},
      "title": "Vision Logs",
      "type": "logs",
      "targets": [
        {"datasource": {"type": "loki", "uid": "loki"}, "expr": "{job=\"anveshak\", service=\"vision\"} | json", "refId": "A"}
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["anveshak", "vision", "deepfake", "yolo", "m4"],
  "templating": {"list": []},
  "time": {"from": "now-3h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
