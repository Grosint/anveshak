{
  "annotations": {"list": []},
  "description": "M1 Source Credibility — credibility score changes, audit log volume, auto-feedback loop activity, and sources below threshold.",
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "links": [{"title": "← Overview", "url": "/d/anveshak-overview", "type": "dashboards", "icon": "external link"}],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 100,
      "title": "Credibility Score Activity",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "#A8D5BA", "value": null}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 1},
      "id": 1,
      "description": "Number of source credibility score increases in the last 24 hours. Zero for extended periods may indicate the auto-feedback loop is not running.",
      "options": {"reduceOptions": {"calcs": ["sum"]}, "colorMode": "background", "graphMode": "area"},
      "title": "Score Increases (24h)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "increase(analyst_credibility_changes_total{direction=\"up\"}[24h])", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "#FFCBA4", "value": null}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 1},
      "id": 2,
      "description": "Number of source credibility score decreases in the last 24 hours. A sustained spike suggests newly detected unreliable sources or deepfake detections.",
      "options": {"reduceOptions": {"calcs": ["sum"]}, "colorMode": "background", "graphMode": "area"},
      "title": "Score Decreases (24h)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "increase(analyst_credibility_changes_total{direction=\"down\"}[24h])", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "#A4C8E8", "value": null}]}}},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 1},
      "id": 3,
      "description": "Total credibility audit events (up + down) in 24 hours. If zero, the analyst service may be down or no sources are being evaluated.",
      "options": {"reduceOptions": {"calcs": ["sum"]}, "colorMode": "background", "graphMode": "area"},
      "title": "Total Audit Events (24h)",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "increase(analyst_credibility_changes_total[24h])", "refId": "A"}]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 101,
      "title": "Credibility Change Trends",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}, "unit": "short", "custom": {"lineWidth": 2, "fillOpacity": 10}},
        "overrides": [
          {"matcher": {"id": "byLabelValue", "options": {"label": "direction", "value": "up"}}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#A8D5BA"}}]},
          {"matcher": {"id": "byLabelValue", "options": {"label": "direction", "value": "down"}}, "properties": [{"id": "color", "value": {"mode": "fixed", "fixedColor": "#F4A4A4"}}]}
        ]
      },
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 6},
      "id": 10,
      "description": "Rate of credibility score changes per hour, split by direction. A sustained 'down' spike indicates a batch of sources being penalised -- check audit logs for root cause.",
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "title": "Credibility Score Changes Over Time (rate/h)",
      "type": "timeseries",
      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (direction) (rate(analyst_credibility_changes_total[30m])) * 3600", "legendFormat": "{{direction}}", "refId": "A"}
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "id": 102,
      "title": "Credibility Audit Log (from Loki)",
      "type": "row"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 15},
      "id": 20,
      "description": "Structured log stream of credibility audit events from the analyst service. Every row maps to an insert in credibility_audit_log. Gaps indicate the analyst service is not processing.",
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "showLabels": true, "showTime": true, "sortOrder": "Descending"},
      "title": "Source Credibility Audit Events",
      "type": "logs",
      "targets": [
        {"datasource": {"type": "loki", "uid": "loki"}, "expr": "{job=\"anveshak\", service=\"analyst\"} |= \"credibility\" | json | event =~ \".*credib.*\"", "refId": "A"}
      ]
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27},
      "id": 103,
      "title": "Source Warning Events (from Reporter)",
      "type": "row"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 28},
      "id": 30,
      "description": "Logs from the reporter service when a source used in a report has since been downgraded. Each entry corresponds to a report_source_warnings insert. High volume means many reports reference now-questionable sources.",
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "showLabels": true, "showTime": true, "sortOrder": "Descending"},
      "title": "Report Source Warning Insertions (CLAUDE.md Rule 8)",
      "type": "logs",
      "targets": [
        {"datasource": {"type": "loki", "uid": "loki"}, "expr": "{job=\"anveshak\", service=\"reporter\"} |= \"warning\" | json | event =~ \".*source_warn.*\"", "refId": "A"}
      ]
    }
  ],
  "refresh": "60s",
  "schemaVersion": 38,
  "tags": ["anveshak", "credibility", "audit", "m1"],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "Anveshak — Credibility / M1",
  "uid": "anveshak-credibility",
  "version": 1
}
