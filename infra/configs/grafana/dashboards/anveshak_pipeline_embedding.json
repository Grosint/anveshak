        "name": "timerange",
        "type": "interval",
        "current": {"text": "24h", "value": "24h"},
        "options": [
          {"text": "1h", "value": "1h"},
          {"text": "6h", "value": "6h"},
          {"text": "24h", "value": "24h"},
          {"text": "7d", "value": "7d"},
          {"text": "30d", "value": "30d"}
