# Git
.git
.gitignore

# Claude Code
.claude

# Python caches
__pycache__
*.pyc
*.pyo
*.egg-info
.pytest_cache
.mypy_cache
.ruff_cache
htmlcov
.coverage

# Node / Frontend build artifacts (frontend has its own Dockerfile)
frontend/node_modules
frontend/dist

# Documentation (not needed in containers)
docs/
*.md
!sdk/anveshak-sdk/README.md

# IDE
.vscode
.idea

# Local environment
.env
.env.*
!.env.example

# Test data / scripts not needed at runtime
tests/
scripts/
benchmarks/

# Docker / Infra configs (not needed inside containers)
#
# Blanket-exclude then re-include, so a new config directory a Dockerfile
# COPYs is invisible to the build context until it is named here. That is
# the .gitignore blanket-pattern trap in its .dockerignore form: the build
# fails with "file not found in build context", and if the COPY were merely
# dropped the services would fall back to an empty lexicon and taxonomy with
# only a log warning.
infra/configs/
!infra/configs/geocoder/
!infra/configs/lexicons/
!infra/configs/taxonomies/
infra/compose*.yml

# Models (downloaded at runtime, not baked in)
models/
!sdk/anveshak/models/

# Media (volume-mounted)
media/
!sdk/anveshak/media/
