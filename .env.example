# =============================================================================
# ANVESHAK — AI-OSINT Platform
# Environment Configuration
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git. See hardware.md for upgrade guidance.
# =============================================================================

# =============================================================================
# CORE SECRETS — REQUIRED (change before first run)
# =============================================================================

# PostgreSQL password — generate with: openssl rand -hex 16
POSTGRES_PASSWORD=change-me-in-production

# Test database URL (used by pytest integration tests — auto-created by make test-integration)
# POSTGRES_TEST_URL=postgresql://anveshak:${POSTGRES_PASSWORD}@localhost:5433/anveshak_test

# JWT signing key — generate with: openssl rand -hex 32
API_SECRET_KEY=change-me-in-production

# Grafana admin password
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

ENVIRONMENT=development
LOG_LEVEL=INFO

# Frontend — API URL reachable from browser
VITE_API_BASE_URL=http://localhost:8000

# CORS origins allowed for API
API_ALLOWED_ORIGINS=http://localhost:3000

# JWT signing key — alias used by some services (maps to API_SECRET_KEY)
# Both API_SECRET_KEY and JWT_SECRET_KEY must match. If only API_SECRET_KEY is set,
# JWT_SECRET_KEY defaults to "change-me-in-production" and the API WILL REFUSE TO START.
JWT_SECRET_KEY=${API_SECRET_KEY}

# JWT expiry in minutes (default: 480 = 8 hours)
JWT_EXPIRE_MINUTES=480

# HSTS — enable only when TLS is terminated upstream (reverse proxy / load balancer)
# Setting to true adds Strict-Transport-Security header on all API responses
HSTS_ENABLED=false

# =============================================================================
# ARQ JOB WORKER SETTINGS
# =============================================================================


# =============================================================================
# OLLAMA — LLM INFERENCE
# Hardware-controlled: see hardware.md for upgrade path
# =============================================================================

# Single model for both cluster labelling and report generation.
# All input is English (post-NLLB translation) — no multilingual LLM needed.
OLLAMA_MODEL=qwen2:7b                  # hardware.md: upgrade to qwen2.5:72b on RTX 4090

# Keep-alive: "5m" = evict after 5min idle (saves RAM), "-1" = keep in VRAM forever (GPU)
OLLAMA_KEEP_ALIVE=5m                   # hardware.md: change to -1 when GPU available

# Parallel requests (increase on GPU)
OLLAMA_NUM_PARALLEL=2

# Report generation timeout (seconds) — CPU needs up to 5min per report
OLLAMA_REPORT_TIMEOUT_S=540

# Ollama circuit breaker — prevents thundering herd during Ollama outages
# After THRESHOLD consecutive failures, all LLM calls are blocked immediately.
# After COOLDOWN_S, one probe call is allowed to test recovery.
OLLAMA_CIRCUIT_BREAKER_THRESHOLD=5
OLLAMA_CIRCUIT_BREAKER_COOLDOWN_S=120

# =============================================================================
# NLP — spaCy MODELS
# Hardware-controlled: see hardware.md for upgrade path
# =============================================================================

SPACY_EN_MODEL=en_core_web_md          # hardware.md: upgrade to en_core_web_trf on 32GB RAM
# English-only NER. Non-English content is translated to English by NLLB first.

# =============================================================================
# TRANSLATION — NLLB-200
# Hardware-controlled: see hardware.md for upgrade path
# =============================================================================

TRANSLATION_ENABLED=true
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M   # hardware.md: upgrade to nllb-200-1.3B on GPU
# CPU limit: Chinese chars ~ 1 token, NLLB max 1024
TRANSLATION_MAX_CHARS=1500
TRANSLATION_MAX_TOKENS=512
# Hard cap on encoder INPUT tokens. TRANSLATION_MAX_CHARS is a character budget
# and cannot bound tokens: 1500 Devanagari chars tokenise to ~514, overrunning
# the model's 512 position limit, and generation then never terminates.
# Must stay below the model limit.
TRANSLATION_MAX_INPUT_TOKENS=480
# Threads per torch op in the analyst worker. Unset, torch takes every core,
# and max_jobs concurrent analyse jobs then oversubscribe the host.
TORCH_NUM_THREADS=2
# CPU limit for the analyst worker container.
ANALYST_WORKER_CPUS=4

# =============================================================================
# ENGINE C — Identifier Intelligence
# =============================================================================

IDENTIFIER_EXTRACTION_ENABLED=true     # extract phones, UPI, crypto, GSTIN, etc. from content
TEMPLATE_MATCHING_ENABLED=true         # match content against scam/fraud templates
# identifier clustering loop interval (seconds)
IDENTIFIER_CLUSTER_INTERVAL_S=300

# =============================================================================
# EMBEDDINGS — sentence-transformers
# Hardware-controlled: see hardware.md for upgrade path
# =============================================================================

EMBEDDING_MODEL=all-MiniLM-L6-v2       # hardware.md: upgrade to BAAI/bge-large-en-v1.5
# hardware.md: change to 1024 with model upgrade
EMBEDDING_DIMENSIONS=384

# =============================================================================
# VISION SERVICE
# Hardware-controlled: see hardware.md for upgrade path
# =============================================================================

VISION_DEVICE=cpu                      # hardware.md: change to cuda when CUDA GPU available

# Media retention: delete processed media files older than N days (0 = keep forever)
# Files are deleted from disk after vision analysis is complete; DB metadata is preserved.
MEDIA_RETENTION_DAYS=30
YOLO_MODEL_SIZE=nano                   # hardware.md: upgrade to xlarge on RTX 3080+
VISION_DEEPFAKE_VIDEO_MODEL=efficientnet  # hardware.md: upgrade to dire on RTX 3080+
# CLIP_MODEL_NAME=openai/clip-vit-base-patch32

# =============================================================================
# SCRAPER SERVICE
# =============================================================================

# Concurrent scraping workers.
# Each slot is a Playwright Chromium at roughly 350-450 MB, so this must stay
# within SCRAPER_MEM_LIMIT or the container is OOM-killed and restart-loops.
SCRAPER_CONCURRENCY=4
# Memory and CPU limits for the web scraper worker container.
SCRAPER_MEM_LIMIT=3g
SCRAPER_WORKER_CPUS=3

# HTTP request timeout in seconds
SCRAPER_REQUEST_TIMEOUT_S=30

# Max article links to follow from each source page
SCRAPER_MAX_LINKS_PER_PAGE=100

# Per-domain delay between requests (seconds) — prevents WAF blocks
SCRAPER_PER_DOMAIN_DELAY_S=1.5

# Random jitter added to per-domain delay (seconds)
SCRAPER_PER_DOMAIN_JITTER_S=0.5

# URL-seen tracking TTL (seconds) — skip re-fetching recently scraped URLs
SCRAPER_URL_SEEN_TTL_S=86400

# Enable/disable URL-seen dedup (set false for debugging)
SCRAPER_URL_SEEN_ENABLED=true

# Optional: route scraping through Tor for anonymisation
# TOR_PROXY_URL=socks5://tor-proxy:9050

# =============================================================================
# DARK WEB COLLECTION (M2 extension — passive OSINT only)
# Tor proxy container is included in compose.yml (alpine + tor)
# Sources: add .onion URLs with platform="darkweb" via the API
# =============================================================================

# Tor SOCKS5 proxy for .onion scraping — auto-configured via Docker Compose
# Override only if running an external Tor instance
# DARKWEB_TOR_PROXY_URL=socks5://tor-proxy:9050

# Timeout per .onion request (Tor adds latency)
DARKWEB_REQUEST_TIMEOUT_S=90

# Concurrent .onion fetches (keep low to avoid Tor circuit exhaustion)
DARKWEB_CONCURRENCY=2

# =============================================================================
# SOCIAL ADAPTERS
# All adapters are opt-in — set *_ADAPTER_ENABLED=true to activate
# =============================================================================

# --- Telegram ---
# How to get: my.telegram.org -> API development tools -> create app
# STEP 1: Set TELEGRAM_API_ID and TELEGRAM_API_HASH from my.telegram.org
# STEP 2: Run: uv run python scripts/bootstrap_telegram_session.py
#         Copy the output TELEGRAM_SESSION_STRING= line into this file.
#         The session string is equivalent to your Telegram login — NEVER commit it.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_ADAPTER_ENABLED=false

# --- Reddit ---
# How to get: reddit.com/prefs/apps -> create "script" app
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=Anveshak OSINT Platform/1.0
# REDDIT_ADAPTER_ENABLED=false

# --- Bluesky ---
# Create a Bluesky account at bsky.app, then enable here.
# BLUESKY_HANDLE=your-handle.bsky.social
# BLUESKY_PASSWORD=
# BLUESKY_ADAPTER_ENABLED=false
# BLUESKY_DAILY_CALL_CAP=7200

# --- Instagram ---
# Uses instagrapi library — requires a real Instagram account.
# Meta rate-limits aggressively. 100 requests/hour cap enforced via Redis.
# WARNING: Use a dedicated account, not your personal one. Meta may flag automated access.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_ADAPTER_ENABLED=false
INSTAGRAM_HOURLY_CALL_CAP=100

# --- Social Circuit Breaker ---
# SOCIAL_CIRCUIT_BREAKER_THRESHOLD=5
# SOCIAL_CIRCUIT_BREAKER_COOLDOWN_S=900

# --- X / Twitter (Official Pay-Per-Use API) ---
# How to get: developer.x.com -> apply for access -> see docs/x_api_application.md
# Cost: $0.005 per read. The spend guard in XAdapter enforces X_MONTHLY_READ_CAP
# atomically (Redis counter). When the cap is reached, ALL X API calls are halted.
#
# !! WARNING: DO NOT RAISE X_MONTHLY_READ_CAP WITHOUT REVIEWING X API BILLING !!
# !! Default cap: 40,000 reads = ~$200/month at $0.005/read                   !!
#
X_BEARER_TOKEN=
X_ADAPTER_ENABLED=false
X_ADAPTER_MODE=polling                 # polling (available now) | stream (Enterprise contract)
X_MONTHLY_READ_CAP=40000

# YouTube Data API v3 — free tier: 10,000 units/day
# Get API key from: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" in the API library
# Quota costs: playlistItems.list=1, videos.list=1, commentThreads.list=1, search.list=100
# Captions fetched via youtube-transcript-api (zero quota cost)
YOUTUBE_API_KEY=
YOUTUBE_ADAPTER_ENABLED=false
YOUTUBE_DAILY_QUOTA_CAP=9000
YOUTUBE_POLL_INTERVAL_S=900
YOUTUBE_FETCH_COMMENTS=true
YOUTUBE_MAX_COMMENTS_PER_VIDEO=100
YOUTUBE_BACKFILL_COUNT=50

# --- WhatsApp (Baileys bridge sidecar) ---
# Self-hosted WhatsApp Web bridge — no Meta Business API dependency.
# Uses QR code authentication (scan with your phone).
# STEP 1: Generate a bridge token: openssl rand -hex 32
# STEP 2: Set WHATSAPP_ADAPTER_ENABLED=true and WHATSAPP_BRIDGE_TOKEN below
# STEP 3: Start bridge: docker compose -p anveshak --env-file .env --profile whatsapp up -d
# STEP 4: Open http://localhost:3002/qr and scan with your phone
# STEP 5: List groups: curl -H "Authorization: Bearer $WHATSAPP_BRIDGE_TOKEN" http://localhost:3002/groups
# STEP 6: Create sources via API with platform="whatsapp", url_or_handle="<group_jid>"
WHATSAPP_ADAPTER_ENABLED=false
WHATSAPP_BRIDGE_TOKEN=
# WHATSAPP_BRIDGE_URL=http://whatsapp-bridge:3002
# WHATSAPP_BUFFER_DRAIN_MAX=100
# WHATSAPP_BUFFER_MAX=10000

# =============================================================================
# ANALYST SCALING
# =============================================================================

# Number of analyst ARQ worker replicas (1 on laptop, 2-4 on production server)
# Each replica needs ~6 GB RAM for ML models (spaCy, NLLB, sentence-transformers)
ANALYST_WORKER_REPLICAS=1

# Content archive + retention (0 = disabled, keep forever in PostgreSQL)
# Items older than N days AND already clustered are archived to compressed JSONL on disk,
# then deleted from PostgreSQL. Cluster metadata, signals, reports are preserved.
# Archive path: {CONTENT_ARCHIVE_ROOT}/{topic_id}/YYYY-MM.jsonl.gz
CONTENT_RETENTION_DAYS=0
CONTENT_ARCHIVE_ROOT=/app/media/archive

# Scheduler throttling — max topics processed per 5-minute clustering cycle
# 0 = unlimited (process all active topics). Set to 50-100 on busy deployments.
# Topics are prioritized by number of unclustered items (most pending first).
MAX_TOPICS_PER_CYCLE=0


# =============================================================================
# SOURCE CREDIBILITY ENGINE (M1)
# All values are tunable; changing them does NOT require a migration.
# =============================================================================

# pts subtracted per high-risk deepfake item
CREDIBILITY_DEEPFAKE_DROP=1.0
# minimum drop delta to write audit log (noise filter)
CREDIBILITY_MIN_AUTO_DROP=1.0
CREDIBILITY_HIGH_THRESHOLD=60.0
CREDIBILITY_CROSS_VERIFY_BOOST=5.0
CREDIBILITY_MIN_AUTO_BOOST=1.0
CREDIBILITY_CONTRADICTION_DROP=5.0
CREDIBILITY_NOISE_RATIO_THRESHOLD=0.6
CREDIBILITY_CONTRADICTION_MIN_ITEMS=5

# =============================================================================
# SIGNAL NOTIFICATIONS (optional)
# Webhook endpoint called when new signals are delivered
# =============================================================================

SIGNAL_WEBHOOK_ENABLED=false
# SIGNAL_WEBHOOK_URL=https://your-webhook-endpoint.example.com/anveshak/signals

# =============================================================================
# DRISHTI BRIDGE (optional)
# One-directional: Anveshak emits extracted entities TO Drishti
# =============================================================================

ANVESHAK_DRISHTI_BRIDGE=false
# DRISHTI_REDPANDA_BOOTSTRAP=redpanda:9092

# =============================================================================
# OBSERVABILITY
# =============================================================================

PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin

# =============================================================================
# OPENTELEMETRY TRACING (optional — requires: docker compose --profile tracing up)
# =============================================================================

OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# 10% sampling in dev; 0.01 (1%) in prod
OTEL_TRACES_SAMPLER_ARG=0.1

# =============================================================================
# QUICK START
# =============================================================================
# 1. cp .env.example .env
# 2. Edit .env — set POSTGRES_PASSWORD, API_SECRET_KEY, GRAFANA_ADMIN_PASSWORD
# 3. make setup           # builds, starts, migrates, validates — full first-run
# 4. make seed-demo       # optional: load Indian Navy demo scenario
# 5. Open http://localhost:3000 (analyst UI) or http://localhost:3001 (Grafana)
