{
  // Type-checks the API contract tests against the app, so a field renamed on
  // a Pydantic response model fails `npm run build`. The rest of src/test/ is
  // left to vitest, as in tsconfig.json.
  "extends": "./tsconfig.json",
  "include": ["src/main.tsx", "src/vite-env.d.ts", "src/test/contracts"],
  // Reads the generated files with node:fs, and the app has no Node types.
  "exclude": ["src/test/contracts/generated-schema.test.ts"]
}
